  "themeCSS": ".node rect, .node circle, .node polygon, .node path { rx: 8; ry: 8; } .node rect { filter: drop-shadow(0 1px 1px rgba(15,23,42,.07)); } .cluster rect { rx: 10; ry: 10; } .cluster-label text, .cluster-label .nodeLabel, .cluster-label span { font-size: 15px; font-weight: 600; letter-spacing: .2px; color: #334155; } .edgeLabel { padding: 2px 7px; border-radius: 6px; font-size: 13px; } .edgeLabel rect { rx: 6; ry: 6; opacity: .94; } .flowchart-link { stroke-width: 1.6px; } .nodeLabel .s { font-size: 13px; font-weight: 400; color: #64748b; }"
