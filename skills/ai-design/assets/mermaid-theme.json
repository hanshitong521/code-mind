    "useMaxWidth": false,
    "defaultRenderer": "dagre"
  },
  "sequence": {
    "useMaxWidth": false,
    "diagramMarginX": 24,
    "diagramMarginY": 16,
    "actorMargin": 60,
    "width": 170,
    "height": 56,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 12,
    "messageMargin": 40,
    "mirrorActors": false,
    "bottomMarginAdj": 4,
    "wrap": true
  },
  "state": {
    "useMaxWidth": false,
    "nodeSpacing": 55,
    "rankSpacing": 58
  },
  "er": {
    "useMaxWidth": false,
    "diagramPadding": 16,
    "layoutDirection": "TB",
    "minEntityWidth": 120,
    "minEntityHeight": 70,
    "entityPadding": 14
  },
  "architecture": {
    "useMaxWidth": false,
    "padding": 18
