    "padding": 14,
    "diagramPadding": 16,
    "useMaxWidth": false,
    "defaultRenderer": "dagre"
  },
  "sequence": {
    "useMaxWidth": false,
    "diagramMarginX": 24,
    "diagramMarginY": 16,
    "actorMargin": 60,
    "width": 170,
    "height": 56,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 12,
    "messageMargin": 40,
    "mirrorActors": false,
    "bottomMarginAdj": 4,
    "wrap": true
  },
  "state": {
    "useMaxWidth": false,
    "nodeSpacing": 55,
    "rankSpacing": 58
  },
  "er": {
    "useMaxWidth": false,
    "diagramPadding": 16,
    "layoutDirection": "TB",
    "minEntityWidth": 120,
    "minEntityHeight": 70,
    "entityPadding": 14
  },
  "architecture": {
    "useMaxWidth": false,
    "padding": 18
  },
  "themeCSS": ".node rect, .node circle, .node polygon, .node path { rx: 8; ry: 8; } .node rect { filter: drop-shadow(0 1px 1px rgba(0,0,0,.45)); } .cluster rect { rx: 10; ry: 10; } .cluster-label text, .cluster-label .nodeLabel, .cluster-label span { font-size: 15px; font-weight: 600; letter-spacing: .2px; color: #cbd5e1; } .edgeLabel { padding: 2px 7px; border-radius: 6px; font-size: 13px; } .edgeLabel rect { rx: 6; ry: 6; opacity: .94; } .flowchart-link { stroke-width: 1.6px; } .nodeLabel .s { font-size: 13px; font-weight: 400; color: #8b949e; }"
}
